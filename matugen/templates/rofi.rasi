/* generated by matugen from the octopus template; edit matugen/templates/rofi.rasi */

* {
  font: "Rubik 10.5";
  background-color: transparent;
  text-color: {{colors.on_surface.default.hex}};
  margin: 0;
  padding: 0;
  spacing: 0;
}

window {
  location: center;
  anchor: center;
  width: 520px;
  height: 440px;
  background-color: {{colors.surface_container.default.hex}};
  border: 0;
  border-radius: 28px;
  padding: 14px;
}

mainbox {
  children: [ inputbar, listview ];
  spacing: 10px;
}

inputbar {
  children: [ textbox-search, entry ];
  background-color: {{colors.surface_container_high.default.hex}};
  border: 2px solid;
  border-color: {{colors.primary.default.hex}};
  border-radius: 999px;
  padding: 8px 16px;
  spacing: 10px;
}

textbox-search {
  expand: false;
  str: "search";
  font: "Material Symbols Rounded 14";
  vertical-align: 0.5;
  text-color: {{colors.on_surface_variant.default.hex}};
}

entry {
  placeholder: "";
  vertical-align: 0.5;
  cursor-color: {{colors.primary.default.hex}};
}

listview {
  lines: 8;
  dynamic: true;
  fixed-height: false;
  scrollbar: false;
}

element {
  children: [ element-icon, element-text ];
  padding: 8px 12px;
  spacing: 10px;
  border-radius: 18px;
}

element-icon {
  size: 28px;
}

element-text {
  vertical-align: 0.5;
  text-color: inherit;
}

element selected.normal,
element selected.active {
  background-color: {{colors.secondary_container.default.hex}};
  text-color: {{colors.on_secondary_container.default.hex}};
}
