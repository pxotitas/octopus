{
  "layer": "top",
  "position": "top",
  "mode": "dock",
  "exclusive": true,
  "passthrough": false,
  "fixed-center": true,
  "height": 42,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 0,
  "reload_style_on_change": true,
  "modules-left": [
    "niri/workspaces",
    "niri/window"
  ],
  "modules-center": [
    "clock",
    "custom/weather",
    "mpris"
  ],
  "modules-right": [
    "tray",
    "network",
    "bluetooth",
    "wireplumber#output",
    "wireplumber#microphone",
    "battery",
    "custom/power"
  ],
  "niri/workspaces": {
    "format": "{value}",
    "display-condition": "show-all",
    "hide-empty": false,
    "current-only": false,
    "sort-by-id": true,
    "all-outputs": false,
    "enable-bar-scroll": false
  },
  "niri/window": {
    "format": "{title}",
    "icon": true,
    "icon-size": 16,
    "max-length": 56,
    "separate-outputs": true
  },
  "clock": {
    "format": "󰥔  {:%H:%M}",
    "tooltip-format": "<big>{:%A, %d %B %Y}</big>\n<tt>{:%H:%M:%S}</tt>",
    "interval": 30,
    "on-click": "ewwii update 'section=\"clock\"' && ewwii open octopus",
    "on-click-right": "ewwii update 'section=\"main\"' && ewwii open octopus"
  },
  "custom/weather": {
    "exec": "python3 $HOME/.config/waybar/scripts/weather.py",
    "return-type": "json",
    "format": "{text}",
    "interval": 900,
    "restart-interval": 60,
    "hide-empty-text": true,
    "on-click": "ewwii update 'section=\"weather\"' && ewwii open octopus",
    "on-click-right": "ewwii update 'section=\"main\"' && ewwii open octopus"
  },
  "mpris": {
    "player": "playerctld",
    "format": "{player_icon}  {title}",
    "format-paused": "{status_icon}  {title}",
    "format-stopped": "",
    "player-icons": {
      "default": "󰎆"
    },
    "status-icons": {
      "playing": "󰐊",
      "paused": "󰏤",
      "stopped": "󰓛"
    },
    "title-len": 34,
    "dynamic-len": 34,
    "max-length": 40,
    "ellipsis": "…",
    "tooltip-format": "{player}: {title}\n{artist}",
    "hide-on-paused": false,
    "on-click": "ewwii update 'section=\"media\"' && ewwii open octopus",
    "on-click-right": "ewwii update 'section=\"main\"' && ewwii open octopus"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "network": {
    "format-wifi": "󰤨  {essid}",
    "format-ethernet": "󰈀  Wired",
    "format-disconnected": "󰤭  Offline",
    "format-icons": [
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}\nGateway: {gwaddr}",
    "max-length": 22,
    "interval": 5,
    "on-click": "ewwii update 'section=\"network\"' && ewwii open octopus"
  },
  "bluetooth": {
    "format": "󰂯  {status}",
    "format-connected": "󰂱  {device_alias}",
    "format-disabled": "󰂲  Off",
    "format-off": "󰂲  Off",
    "format-on": "󰂯  On",
    "format-icons": {
      "enabled": "󰂯",
      "disabled": "󰂲",
      "connected": "󰂱"
    },
    "tooltip-format": "{controller_alias}\n{num_connections} connected",
    "on-click": "ewwii update 'section=\"bluetooth\"' && ewwii open octopus",
    "format-no-controller": "󰂲  Unavailable"
  },
  "wireplumber#output": {
    "node-type": "Audio/Sink",
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟  Muted",
    "format-icons": [
      "󰕿",
      "󰖀",
      "󰕾"
    ],
    "scroll-step": 2,
    "on-click": "ewwii update 'section=\"audio\"' && ewwii open octopus"
  },
  "wireplumber#microphone": {
    "node-type": "Audio/Source",
    "format": "{icon}  {volume}%",
    "format-muted": "󰍭  Muted",
    "format-icons": [
      "󰍬",
      "󰍬",
      "󰍬"
    ],
    "scroll-step": 2,
    "on-click": "ewwii update 'section=\"microphone\"' && ewwii open octopus"
  },
  "battery": {
    "interval": 30,
    "states": {
      "warning": 25,
      "critical": 10
    },
    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-plugged": "󰚥  {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "tooltip-format": "{timeTo}\n{power} W",
    "format-full": "󰁹  100%"
  },
  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "ewwii update 'section=\"power\"' && ewwii open octopus"
  }
}
