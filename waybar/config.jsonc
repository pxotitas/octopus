{
  "layer": "top",
  "position": "left",
  "margin-top": 8,
  "margin-bottom": 8,
  "margin-left": 8,
  "spacing": 6,
  "reload_style_on_change": true,

  "modules-left": ["custom/launcher", "niri/workspaces", "niri/window"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "custom/battery", "group/controls"],

  "custom/launcher": {
    "format": "\uf303",
    "tooltip": false,
    "on-click": "~/.config/octopus/scripts/launcher.sh"
  },

  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": { "default": "", "active": "" }
  },

  "niri/window": {
    "format": "",
    "icon": true,
    "icon-size": 22,
    "separate-outputs": true
  },

  "clock": {
    "format": "{:%H\n%M}",
    "locale": "pt_BR.UTF-8",
    "tooltip-format": "{:%A, %d de %B}",
    "on-click": "octopus toggle dash"
  },

  "tray": {
    "icon-size": 18,
    "spacing": 8
  },

  "custom/battery": {
    "exec": "~/.config/octopus/scripts/battery.sh",
    "return-type": "json",
    "interval": 20,
    "signal": 9,
    "format": "{}"
  },

  "group/controls": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 320,
      "children-class": "control-child",
      "transition-left-to-right": false
    },
    "modules": ["custom/control-center", "network", "bluetooth", "wireplumber", "custom/power"]
  },

  "custom/control-center": {
    "format": "tune",
    "tooltip-format": "central de controle",
    "on-click": "octopus toggle control-center"
  },

  "network": {
    "format-wifi": "{icon}",
    "format-ethernet": "lan",
    "format-disconnected": "wifi_off",
    "format-disabled": "wifi_off",
    "format-icons": ["network_wifi_1_bar", "network_wifi_2_bar", "network_wifi_3_bar", "signal_wifi_4_bar"],
    "tooltip-format-wifi": "{essid} · {signalStrength}%",
    "tooltip-format-disconnected": "desconectado",
    "on-click": "octopus toggle wifi"
  },

  "bluetooth": {
    "format": "bluetooth",
    "format-disabled": "bluetooth_disabled",
    "format-off": "bluetooth_disabled",
    "format-connected": "bluetooth_connected",
    "tooltip-format-connected": "{device_alias}",
    "on-click": "octopus toggle bluetooth"
  },

  "wireplumber": {
    "format": "{icon}",
    "format-muted": "volume_off",
    "format-icons": ["volume_mute", "volume_down", "volume_up"],
    "tooltip-format": "{volume}% · {node_name}",
    "on-click": "octopus toggle audio",
    "scroll-step": 5
  },

  "custom/power": {
    "format": "power_settings_new",
    "tooltip-format": "energia",
    "on-click": "~/.config/octopus/scripts/powermenu.sh"
  }
}
