// Generated by octopus from octopus.toml [bar]; change it in `octopus settings`.
{
  "battery": {
    "format": "{capacity}",
    "interval": 60,
    "tooltip": false
  },
  "bluetooth": {
    "format": "bluetooth",
    "format-connected": "bluetooth_connected",
    "format-disabled": "bluetooth_disabled",
    "format-off": "bluetooth_disabled",
    "on-click": "octopus toggle bluetooth",
    "tooltip-format-connected": "{device_alias}"
  },
  "cffi/tray": {
    "module_path": "/home/px/.cache/octopus/tray-arrow.so",
    "position": "left"
  },
  "clock": {
    "format": "{:%H\n%M}",
    "justify": "center",
    "locale": "pt_BR.UTF-8",
    "on-click": "octopus toggle dash",
    "tooltip-format": "{:%A, %d de %B}"
  },
  "custom/battery": {
    "exec": "~/.config/octopus/scripts/battery.sh",
    "format": "{}",
    "icon-size": 0,
    "icon-spacing": 0,
    "interval": 20,
    "return-type": "json",
    "signal": 9
  },
  "custom/control-center": {
    "format": "tune",
    "icon-size": 0,
    "icon-spacing": 0,
    "on-click": "octopus toggle control-center",
    "tooltip-format": "central de controle"
  },
  "custom/launcher": {
    "format": "",
    "icon-size": 0,
    "icon-spacing": 0,
    "on-click": "~/.config/octopus/scripts/wofi.sh",
    "tooltip": false,
    "tooltip-format": ""
  },
  "custom/power": {
    "format": "power_settings_new",
    "icon-size": 0,
    "icon-spacing": 0,
    "on-click": "octopus toggle power",
    "tooltip-format": "energia"
  },
  "custom/tray": {
    "exec": "octopus tray-status",
    "format": "{}",
    "icon-size": 0,
    "icon-spacing": 0,
    "interval": "once",
    "on-click": "octopus toggle tray",
    "return-type": "json",
    "signal": 8
  },
  "group/charge": {
    "modules": [
      "custom/battery",
      "battery"
    ],
    "orientation": "inherit"
  },
  "group/controls": {
    "drawer": {
      "children-class": "control-child",
      "transition-duration": 320,
      "transition-left-to-right": false
    },
    "modules": [
      "custom/control-center",
      "network",
      "bluetooth",
      "wireplumber",
      "custom/power"
    ],
    "orientation": "inherit"
  },
  "layer": "top",
  "margin-bottom": 8,
  "margin-left": 8,
  "margin-top": 8,
  "modules-center": [
    "clock"
  ],
  "modules-left": [
    "custom/launcher",
    "niri/workspaces"
  ],
  "modules-right": [
    "cffi/tray",
    "group/charge",
    "group/controls"
  ],
  "network": {
    "format-disabled": "wifi_off",
    "format-disconnected": "wifi_off",
    "format-ethernet": "lan",
    "format-icons": [
      "network_wifi_1_bar",
      "network_wifi_2_bar",
      "network_wifi_3_bar",
      "signal_wifi_4_bar"
    ],
    "format-wifi": "{icon}",
    "on-click": "octopus toggle wifi",
    "tooltip-format-disconnected": "desconectado",
    "tooltip-format-wifi": "{essid} · {signalStrength}%"
  },
  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "default": ""
    }
  },
  "position": "left",
  "reload_style_on_change": true,
  "spacing": 4,
  "width": 40,
  "wireplumber": {
    "format": "{icon}",
    "format-icons": [
      "volume_mute",
      "volume_down",
      "volume_up"
    ],
    "format-muted": "volume_off",
    "on-click": "octopus toggle audio",
    "scroll-step": 5,
    "tooltip-format": "{volume}% · {node_name}"
  }
}
